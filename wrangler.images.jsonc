{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "f-movies-images",
  "main": "workers/image-proxy.ts",
  "compatibility_date": "2026-07-22",
  "routes": [
    { "pattern": "images.watchfmovies.org", "custom_domain": true }
  ],
  "r2_buckets": [
    { "binding": "TMDB_IMAGES", "bucket_name": "f-movies-tmdb-images" }
  ],
  "observability": {
    "enabled": true
  }
}
