---
import MediaGrid from "../components/MediaGrid.astro";
import Pagination from "../components/Pagination.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { canonicalPath, catalogCacheControl, paginationLinks } from "../lib/seo";
import { getTmdbToken, TmdbClient } from "../lib/tmdb";

if (Astro.url.searchParams.get("page") === "1") return Astro.redirect("/tv-series", 301);
const requestedPage = Number(Astro.url.searchParams.get("page") ?? 1);
const page = Number.isFinite(requestedPage) ? Math.max(1, Math.min(500, Math.floor(requestedPage))) : 1;
Astro.response.headers.set("Cache-Control", catalogCacheControl);
const client = new TmdbClient(getTmdbToken());
const catalog = await client.getPopular("tv", page);
if (catalog.totalPages > 0 && page > catalog.totalPages) return Astro.rewrite("/404");
---

<BaseLayout
  title="Popular TV Series to Discover — Cast, Seasons & More | F.MOVIES"
  description="Browse popular TV series with season details, community ratings, cast information and related recommendations. Explore the F.MOVIES catalogue to find your next series to start."
  canonicalPath={canonicalPath("/tv-series", catalog.page)}
  paginationLinks={paginationLinks("/tv-series", catalog.page, catalog.totalPages)}
>
  <header class="page-heading">
    <div class="container">
      <span class="section-kicker">Series library</span>
      <h1>Popular TV series</h1>
      <p>Find long-form stories, limited series and returning favorites.</p>
    </div>
  </header>
  <div class="page-content container">
    <MediaGrid items={catalog.results} priorityCount={6} />
    <Pagination page={catalog.page} totalPages={catalog.totalPages} pathname="/tv-series" />
  </div>
</BaseLayout>
