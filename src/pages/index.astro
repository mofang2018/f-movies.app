---
import BaseLayout from "../layouts/BaseLayout.astro";

Astro.response.headers.set("Cache-Control", "public, s-maxage=86400, stale-while-revalidate=604800");

const faqItems = [
  {
    question: "What is FMovies?",
    answer: "FMovies is a movie and TV-series discovery catalogue. Browse titles, ratings, cast information, genres, countries, and recommendations when you are choosing what to watch next.",
  },
  {
    question: "How do I search FMovies by title?",
    answer: "Use the search box to enter a movie or TV-series title. FMovies shows matching catalogue entries so you can open a title page and explore its synopsis, rating, cast, and related recommendations.",
  },
  {
    question: "How can I browse Watch FMovies without searching?",
    answer: "Start with Movies, TV Series, Top IMDb, a genre, or a country. These paths make it easy to move from a broad idea to specific titles and discover something that matches your mood.",
  },
  {
    question: "Does FMovies require an account?",
    answer: "No account is needed to explore the FMovies catalogue. You can search titles, browse collections, and open movie or TV-series pages directly in your browser.",
  },
  {
    question: "Can I use Watch FMovies on mobile devices?",
    answer: "Yes. Watch FMovies is designed to work across phones, tablets, and desktop browsers, with responsive navigation and search for discovering titles on any screen size.",
  },
  {
    question: "How are FMovies genres and country pages organised?",
    answer: "Genre and country pages group titles by their metadata, helping you explore categories such as action, comedy, horror, science fiction, or productions connected to a selected country.",
  },
  {
    question: "How often is the Watch FMovies catalogue updated?",
    answer: "Watch FMovies refreshes its catalogue with current movie and TV-series metadata as new information becomes available, including titles, ratings, cast details, and release information.",
  },
  {
    question: "Where does FMovies get movie and TV-series information?",
    answer: "FMovies uses TMDB metadata to present movie and TV-series details, including title summaries, cast information, release dates, ratings, and images.",
  },
];

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "FMOVIES",
    alternateName: "fmovies",
    url: Astro.site?.href,
    potentialAction: {
      "@type": "SearchAction",
      target: `${Astro.site?.href ?? "https://watchfmovies.org"}search?q={search_term_string}`,
      "query-input": "required name=search_term_string",
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqItems.map((item) => ({
      "@type": "Question",
      name: item.question,
      acceptedAnswer: {
        "@type": "Answer",
        text: item.answer,
      },
    })),
  },
];
---

<BaseLayout
  title="Watch FMovies — Discover Movies & TV Series | FMOVIES"
  description="Watch FMovies to search movie and TV-series information, browse genres, countries, ratings and cast details, and discover your next title."
  structuredData={structuredData}
>
  <section class="landing-hero">
    <div class="landing-orb landing-orb-one"></div>
    <div class="landing-orb landing-orb-two"></div>
    <div class="landing-hero-content container">
      <span class="landing-kicker">Movie discovery guide</span>
      <h1>Watch FMovies: discover movies and TV series</h1>
      <p>Watch FMovies to search titles, browse popular genres and countries, and build your next watchlist with movie and TV-series details in one place.</p>
      <form class="landing-search" action="/search" method="get">
        <label class="screen-reader-only" for="landing-query">Search titles</label>
        <input id="landing-query" type="search" name="q" placeholder="Search movies and TV series" autocomplete="off" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="landing-suggestions" />
        <button class="button button-primary" type="submit">Search</button>
        <div id="landing-suggestions" class="landing-suggestions" role="listbox" hidden></div>
      </form>
      <div class="landing-actions">
        <a class="button button-secondary" href="/home">Go to home page</a>
      </div>
    </div>
  </section>

  <div class="landing-content container">
    <section class="intro-grid" aria-labelledby="what-is-fmovies">
      <div>
        <span class="section-kicker">A simpler starting point</span>
        <h2 id="what-is-fmovies">What is this catalogue?</h2>
      </div>
      <p>FMOVIES is a fast catalogue for discovering movie and TV-series details. When you watch FMovies for your next pick, use it to search titles, compare ratings, browse cast information, or follow a genre before deciding what to watch next.</p>
    </section>

    <section class="discovery-cards" aria-label="Browse fmovies">
      <a href="/movies">
        <span>01</span>
        <h2>Movies</h2>
        <p>Browse popular films, new discoveries, and highly rated titles.</p>
      </a>
      <a href="/tv-series">
        <span>02</span>
        <h2>TV series</h2>
        <p>Find series details, seasons, cast, and related recommendations.</p>
      </a>
      <a href="/top-imdb">
        <span>03</span>
        <h2>Top rated</h2>
        <p>Explore community-rated movie picks in one focused list.</p>
      </a>
    </section>

    <section class="browse-grid" aria-labelledby="browse-fmovies">
      <div>
        <span class="section-kicker">Find your next title</span>
        <h2 id="browse-fmovies">Browse fmovies your way</h2>
        <p>Move from a broad search to a specific movie or TV-series page in a few clicks. Watch FMovies by title, genre, country, popularity, or rating to find details for your next pick.</p>
      </div>
      <nav aria-label="Featured discovery links">
        <a href="/genre/action">Action movies</a>
        <a href="/genre/comedy">Comedy movies</a>
        <a href="/genre/horror">Horror movies</a>
        <a href="/genre/science-fiction">Science fiction</a>
        <a href="/country/united-states">United States</a>
        <a href="/country/japan">Japan</a>
      </nav>
    </section>

    <section class="landing-faq" aria-labelledby="fmovies-faq">
      <span class="section-kicker">FMOVIES FAQ</span>
      <h2 id="fmovies-faq">Watch FMovies: frequently asked questions</h2>
      {faqItems.map((item) => (
        <details>
          <summary>{item.question}</summary>
          <p>{item.answer}</p>
        </details>
      ))}
    </section>
  </div>
</BaseLayout>

<script>
  interface Suggestion {
    title: string;
    year: string | null;
    url: string;
  }

  const form = document.querySelector(".landing-search");
  const input = form?.querySelector('input[type="search"]');
  const panel = form?.querySelector(".landing-suggestions");

  if (input instanceof HTMLInputElement && panel instanceof HTMLElement) {
    let timer: ReturnType<typeof setTimeout> | undefined;
    let controller: AbortController | undefined;
    let activeIndex = -1;

    const close = () => {
      if (timer) clearTimeout(timer);
      controller?.abort();
      activeIndex = -1;
      panel.hidden = true;
      panel.replaceChildren();
      input.setAttribute("aria-expanded", "false");
      input.removeAttribute("aria-activedescendant");
    };

    const select = (index: number) => {
      const options = Array.from(panel.querySelectorAll<HTMLAnchorElement>("a"));
      activeIndex = index;
      options.forEach((option, optionIndex) => option.classList.toggle("active", optionIndex === index));
      const active = options[index];
      if (active) input.setAttribute("aria-activedescendant", active.id);
      else input.removeAttribute("aria-activedescendant");
    };

    const show = (results: Suggestion[]) => {
      panel.replaceChildren();
      activeIndex = -1;
      if (!results.length) {
        panel.hidden = true;
        input.setAttribute("aria-expanded", "false");
        return;
      }
      results.forEach((result, index) => {
        const option = document.createElement("a");
        option.href = result.url;
        option.id = `landing-query-suggestion-${index}`;
        option.setAttribute("role", "option");
        option.className = "landing-suggestion";
        const title = document.createElement("span");
        title.textContent = result.title;
        const year = document.createElement("span");
        year.className = "landing-suggestion-year";
        year.textContent = result.year ?? "-";
        option.appendChild(title);
        option.appendChild(year);
        panel.appendChild(option);
      });
      panel.hidden = false;
      input.setAttribute("aria-expanded", "true");
    };

    input.addEventListener("input", () => {
      if (timer) clearTimeout(timer);
      controller?.abort();
      const query = input.value.trim();
      if (query.length < 3) {
        close();
        return;
      }
      timer = setTimeout(async () => {
        controller = new AbortController();
        try {
          const response = await fetch(`/api/suggest?q=${encodeURIComponent(query)}`, { signal: controller.signal });
          if (!response.ok || input.value.trim() !== query) return;
          const data = await response.json() as { results?: Suggestion[] };
          show(Array.isArray(data.results) ? data.results : []);
        } catch (error) {
          if ((error as DOMException).name !== "AbortError") close();
        }
      }, 300);
    });

    input.addEventListener("keydown", (event) => {
      const options = Array.from(panel.querySelectorAll<HTMLAnchorElement>("a"));
      if (event.key === "Escape") {
        close();
      } else if (event.key === "ArrowDown" && options.length) {
        event.preventDefault();
        select((activeIndex + 1) % options.length);
      } else if (event.key === "ArrowUp" && options.length) {
        event.preventDefault();
        select((activeIndex - 1 + options.length) % options.length);
      } else if (event.key === "Enter" && activeIndex >= 0 && options[activeIndex]) {
        event.preventDefault();
        options[activeIndex].click();
      }
    });

    input.addEventListener("blur", () => setTimeout(close, 150));
  }
</script>

<style>
  .landing-hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    min-height: 580px;
    padding: 128px 0 112px;
    background:
      linear-gradient(105deg, rgba(11, 13, 17, 0.98) 4%, rgba(19, 27, 28, 0.91) 52%, rgba(28, 39, 22, 0.84)),
      #151a1c;
  }

  .landing-orb {
    position: absolute;
    z-index: -1;
    border-radius: 999px;
    filter: blur(5px);
    opacity: 0.46;
  }

  .landing-orb-one {
    top: -190px;
    right: -50px;
    width: 650px;
    height: 650px;
    background: radial-gradient(circle, #92c32e 0%, rgba(146, 195, 46, 0) 68%);
  }

  .landing-orb-two {
    right: 27%;
    bottom: -290px;
    width: 540px;
    height: 540px;
    background: radial-gradient(circle, #00778a 0%, rgba(0, 119, 138, 0) 68%);
  }

  .landing-hero-content {
    display: flex;
    max-width: calc(var(--content-width) - 140px);
    align-items: center;
    flex-direction: column;
    margin-left: max(24px, calc((100vw - var(--content-width)) / 2));
    margin-right: max(24px, calc((100vw - var(--content-width)) / 2));
    text-align: center;
  }

  .landing-kicker {
    display: block;
    margin-bottom: 15px;
    color: var(--color-accent);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .landing-hero h1 {
    max-width: 760px;
    margin: 0;
    font-size: clamp(42px, 6vw, 74px);
    letter-spacing: -0.045em;
    line-height: 0.99;
  }

  .landing-hero p {
    max-width: 650px;
    margin: 22px auto 0;
    color: #d1d6d5;
    font-size: clamp(17px, 2vw, 20px);
  }

  .landing-search {
    position: relative;
    display: flex;
    width: min(100%, 680px);
    gap: 8px;
    margin: 32px auto 0;
  }

  .landing-search input {
    min-width: 0;
    flex: 1;
    height: 56px;
    padding: 0 20px;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: var(--radius);
    outline: 0;
    background: rgba(10, 13, 15, 0.7);
    color: #fff;
  }

  .landing-search input:focus {
    border-color: var(--color-accent);
  }

  .landing-search .button {
    min-height: 56px;
    flex: 0 0 auto;
  }

  .landing-suggestions {
    position: absolute;
    z-index: 10;
    top: calc(100% + 8px);
    right: 94px;
    left: 0;
    overflow: hidden;
    border: 1px solid rgba(172, 221, 38, 0.42);
    border-radius: var(--radius);
    background: #161c21;
    box-shadow: 0 20px 46px rgba(0, 0, 0, 0.46);
    text-align: left;
  }

  :global(.landing-suggestion) {
    display: flex;
    min-height: 50px;
    align-items: center;
    justify-content: space-between;
    gap: 22px;
    padding: 0 18px 0 20px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.09);
    color: #f4f6f4;
    font-size: 15px;
    font-weight: 650;
  }

  :global(.landing-suggestion:last-child) {
    border-bottom: 0;
  }

  :global(.landing-suggestion:hover),
  :global(.landing-suggestion.active) {
    background: rgba(172, 221, 38, 0.14);
    color: #d4f16f;
  }

  :global(.landing-suggestion-year) {
    flex: 0 0 auto;
    color: #aeb6b5;
    font-size: 13px;
    font-variant-numeric: tabular-nums;
    font-weight: 700;
  }

  :global(.landing-suggestion:hover .landing-suggestion-year),
  :global(.landing-suggestion.active .landing-suggestion-year) {
    color: #d4f16f;
  }

  .landing-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 18px;
  }

  .landing-content {
    padding-top: 74px;
    padding-bottom: 96px;
  }

  .intro-grid,
  .browse-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: 64px;
    align-items: start;
  }

  .intro-grid h2,
  .browse-grid h2,
  .landing-faq h2 {
    margin: 7px 0 0;
    font-size: clamp(28px, 3vw, 42px);
    line-height: 1.1;
  }

  .intro-grid p,
  .browse-grid p {
    margin: 0;
    color: var(--color-muted);
    font-size: 17px;
  }

  .discovery-cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    margin: 68px 0;
  }

  .discovery-cards a {
    min-height: 218px;
    padding: 26px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    transition: border-color var(--transition-fast), background var(--transition-fast), transform var(--transition-fast);
  }

  .discovery-cards a:hover {
    border-color: rgba(183, 227, 43, 0.55);
    background: var(--color-surface-raised);
    transform: translateY(-3px);
  }

  .discovery-cards span {
    color: var(--color-accent);
    font-size: 13px;
    font-weight: 800;
  }

  .discovery-cards h2 {
    margin: 32px 0 8px;
    font-size: 24px;
  }

  .discovery-cards p {
    margin: 0;
    color: var(--color-muted);
    font-size: 14px;
  }

  .browse-grid {
    padding: 48px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: linear-gradient(135deg, #242b2a, #1e222b);
  }

  .browse-grid nav {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
  }

  .browse-grid nav a {
    padding: 13px 14px;
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: var(--radius-sm);
    background: rgba(255, 255, 255, 0.04);
    color: #e7e9ea;
    font-size: 14px;
    transition: border-color var(--transition-fast), color var(--transition-fast);
  }

  .browse-grid nav a:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .landing-faq {
    max-width: 850px;
    margin: 82px auto 0;
  }

  .landing-faq details {
    padding: 19px 0;
    border-bottom: 1px solid var(--color-border);
  }

  .landing-faq summary {
    color: #f4f5f7;
    cursor: pointer;
    font-weight: 700;
  }

  .landing-faq p {
    margin: 12px 28px 0 0;
    color: var(--color-muted);
    font-size: 14px;
  }

  @media (max-width: 760px) {
    .landing-hero {
      min-height: 520px;
      padding: 94px 0 74px;
    }

    .landing-hero-content {
      width: min(100% - 32px, var(--content-width));
      margin-inline: auto;
    }

    .landing-search,
    .intro-grid,
    .browse-grid {
      grid-template-columns: 1fr;
    }

    .landing-search {
      width: 100%;
      gap: 6px;
    }

    .landing-search .button {
      min-height: 54px;
      padding-inline: 16px;
    }

    .landing-suggestions {
      right: 88px;
    }

    .landing-content {
      padding-top: 52px;
      padding-bottom: 68px;
    }

    .intro-grid,
    .browse-grid {
      gap: 24px;
    }

    .discovery-cards {
      grid-template-columns: 1fr;
      margin: 44px 0;
    }

    .discovery-cards a {
      min-height: 0;
    }

    .discovery-cards h2 {
      margin-top: 20px;
    }

    .browse-grid {
      padding: 28px;
    }

    .browse-grid nav {
      grid-template-columns: 1fr;
    }

    .landing-faq {
      margin-top: 58px;
    }
  }
</style>
