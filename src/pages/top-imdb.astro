---
import MediaGrid from "../components/MediaGrid.astro";
import Pagination from "../components/Pagination.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { canonicalPath, catalogCacheControl, paginationLinks } from "../lib/seo";
import { getTmdbToken, TmdbClient } from "../lib/tmdb";

if (Astro.url.searchParams.get("page") === "1") return Astro.redirect("/top-imdb", 301);
const requestedPage = Number(Astro.url.searchParams.get("page") ?? 1);
const page = Number.isFinite(requestedPage) ? Math.max(1, Math.min(500, Math.floor(requestedPage))) : 1;
Astro.response.headers.set("Cache-Control", catalogCacheControl);
const client = new TmdbClient(getTmdbToken());
const catalog = await client.getTopRated(page);
if (catalog.totalPages > 0 && page > catalog.totalPages) return Astro.rewrite("/404");
---

<BaseLayout
  title="Top Rated Movies — Community Picks & Details | F.MOVIES"
  description="Explore highly rated movies in the F.MOVIES catalogue, ordered by TMDB community rating with cast, story details and recommendations to help you find acclaimed films to watch."
  canonicalPath={canonicalPath("/top-imdb", catalog.page)}
  paginationLinks={paginationLinks("/top-imdb", catalog.page, catalog.totalPages)}
>
  <header class="page-heading">
    <div class="container">
      <span class="section-kicker">Audience favorites</span>
      <h1>Top Rated</h1>
      <p>Explore acclaimed movies ranked by TMDB community rating.</p>
    </div>
  </header>
  <div class="page-content container">
    <MediaGrid items={catalog.results} priorityCount={6} />
    <Pagination page={catalog.page} totalPages={catalog.totalPages} pathname="/top-imdb" />
  </div>
</BaseLayout>
