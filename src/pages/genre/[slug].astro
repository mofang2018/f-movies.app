---
import MediaGrid from "../../components/MediaGrid.astro";
import Pagination from "../../components/Pagination.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { genrePath, genreSlug } from "../../lib/genre-url";
import { canonicalPath, catalogCacheControl, paginationLinks } from "../../lib/seo";
import { getTmdbToken, TmdbClient } from "../../lib/tmdb";

const slug = Astro.params.slug;
if (!slug || !/^[a-z]+(?:-[a-z]+)*$/.test(slug)) return Astro.rewrite("/404");
const requestedPage = Number(Astro.url.searchParams.get("page") ?? 1);
const page = Number.isFinite(requestedPage) ? Math.max(1, Math.min(500, Math.floor(requestedPage))) : 1;
Astro.response.headers.set("Cache-Control", catalogCacheControl);
const client = new TmdbClient(getTmdbToken());
const genres = await client.getGenres();
const genre = genres.find((item) => genreSlug(item.name) === slug);
if (!genre) return Astro.rewrite("/404");
const basePath = genrePath(genre);
if (Astro.url.searchParams.get("page") === "1") return Astro.redirect(basePath, 301);
const catalog = await client.getByGenre(genre.id, page);
if (catalog.totalPages > 0 && page > catalog.totalPages) return Astro.rewrite("/404");
const pagePath = canonicalPath(basePath, catalog.page);
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "CollectionPage", name: `${genre.name} Movies`, url: new URL(pagePath, Astro.site).href },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: new URL("/home", Astro.site).href },
        { "@type": "ListItem", position: 2, name: `${genre.name} Movies`, item: new URL(pagePath, Astro.site).href },
      ],
    },
  ],
};
---

<BaseLayout
  title={`${genre.name} Movies — Ratings, Cast & More | FMOVIES`}
  description={`Discover ${genre.name.toLowerCase()} movies with story summaries, community ratings, cast details and recommendations. Browse the FMOVIES catalogue to find your next film.`}
  canonicalPath={pagePath}
  paginationLinks={paginationLinks(basePath, catalog.page, catalog.totalPages)}
  structuredData={structuredData}
>
  <Breadcrumbs items={[{ href: "/home", label: "Home" }, { label: `${genre.name} Movies` }]} />
  <header class="page-heading">
    <div class="container">
      <span class="section-kicker">Browse by genre</span>
      <h1>{genre.name} movies</h1>
      <p>Popular and noteworthy titles in {genre.name.toLowerCase()}.</p>
    </div>
  </header>
  <div class="page-content container">
    <MediaGrid items={catalog.results} priorityCount={6} />
    <Pagination page={catalog.page} totalPages={catalog.totalPages} pathname={basePath} />
  </div>
</BaseLayout>
