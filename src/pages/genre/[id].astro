---
import MediaGrid from "../../components/MediaGrid.astro";
import Pagination from "../../components/Pagination.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { canonicalPath, catalogCacheControl, paginationLinks } from "../../lib/seo";
import { getTmdbToken, TmdbClient } from "../../lib/tmdb";

const genreId = Number(Astro.params.id);
if (!Number.isInteger(genreId) || genreId <= 0) return Astro.rewrite("/404");
if (Astro.url.searchParams.get("page") === "1") return Astro.redirect(`/genre/${genreId}`, 301);
const requestedPage = Number(Astro.url.searchParams.get("page") ?? 1);
const page = Number.isFinite(requestedPage) ? Math.max(1, Math.min(500, Math.floor(requestedPage))) : 1;
Astro.response.headers.set("Cache-Control", catalogCacheControl);
const client = new TmdbClient(getTmdbToken());
const [catalog, genres] = await Promise.all([client.getByGenre(genreId, page), client.getGenres()]);
const genre = genres.find((item) => item.id === genreId);
if (!genre) return Astro.rewrite("/404");
const genreName = genre?.name ?? "Genre";
if (catalog.totalPages > 0 && page > catalog.totalPages) return Astro.rewrite("/404");
---

<BaseLayout
  title={`${genreName} Movies — Ratings, Cast & More | F.MOVIES`}
  description={`Browse ${genreName.toLowerCase()} movies with community ratings, story details, cast information and recommendations from the F.MOVIES catalogue.`}
  canonicalPath={canonicalPath(`/genre/${genreId}`, catalog.page)}
  paginationLinks={paginationLinks(`/genre/${genreId}`, catalog.page, catalog.totalPages)}
>
  <header class="page-heading">
    <div class="container">
      <span class="section-kicker">Browse by genre</span>
      <h1>{genreName} movies</h1>
      <p>Popular and noteworthy titles in {genreName.toLowerCase()}.</p>
    </div>
  </header>
  <div class="page-content container">
    <MediaGrid items={catalog.results} priorityCount={6} />
    <Pagination page={catalog.page} totalPages={catalog.totalPages} pathname={`/genre/${genreId}`} />
  </div>
</BaseLayout>
