---
import { Search } from "@lucide/astro";
import MediaGrid from "../components/MediaGrid.astro";
import Pagination from "../components/Pagination.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { paginationLinks } from "../lib/seo";
import { getTmdbToken, TmdbClient } from "../lib/tmdb";

const query = (Astro.url.searchParams.get("q") ?? "").trim().slice(0, 120);
if (Astro.url.searchParams.get("page") === "1") {
  return Astro.redirect(query ? `/search?q=${encodeURIComponent(query)}` : "/search", 301);
}
const requestedPage = Number(Astro.url.searchParams.get("page") ?? 1);
const page = Number.isFinite(requestedPage) ? Math.max(1, Math.min(500, Math.floor(requestedPage))) : 1;
Astro.response.headers.set("Cache-Control", "public, s-maxage=300, stale-while-revalidate=900");
const client = new TmdbClient(getTmdbToken());
const catalog = await client.search(query, page);
const displayedQuery = catalog.correctedQuery ?? query;
if (catalog.totalPages > 0 && page > catalog.totalPages) return Astro.rewrite("/404");
const searchParams = new URLSearchParams(query ? { q: query } : {});
if (catalog.page > 1) searchParams.set("page", String(catalog.page));
const searchCanonical = searchParams.size ? `/search?${searchParams}` : "/search";
const searchPaginationPath = query ? `/search?${new URLSearchParams({ q: query })}` : "/search";
---

<BaseLayout
  title={query ? `Search ${query} — Movies & TV Series | FMOVIES` : "Search Movies & TV Series — Find Titles & Details | FMOVIES"}
  description={query
    ? `Search results for ${query} across the FMOVIES catalogue. Explore movie and TV-series details, ratings, cast information and related titles before deciding what to watch next.`
    : "Search the FMOVIES catalogue for movie and TV-series details, ratings, cast information and related recommendations to help you choose what to explore next."}
  robots="noindex,follow"
  canonicalPath={searchCanonical}
  paginationLinks={paginationLinks(searchPaginationPath, catalog.page, catalog.totalPages)}
>
  <header class="page-heading search-heading">
    <div class="container">
      <span class="section-kicker">Search the library</span>
      <h1>{query ? catalog.correctedQuery ? `Closest results for “${displayedQuery}”` : `Results for “${query}”` : "Find a title"}</h1>
      <p>{query ? catalog.correctedQuery ? `Showing close matches for “${query}” from the FMOVIES catalogue.` : `${catalog.totalResults.toLocaleString()} matching titles found.` : "Search movies and TV series by title."}</p>
      <form class="search-form" action="/search" method="get">
        <label class="screen-reader-only" for="page-query">Search movies and TV series</label>
        <input id="page-query" type="search" name="q" value={query} placeholder="Movie or TV series title..." autofocus={!query} />
        <button class="button button-primary" type="submit">Search</button>
      </form>
    </div>
  </header>
  <div class="page-content container">
    {catalog.results.length > 0 ? (
      <>
        {catalog.correctedQuery && <p class="search-note">Try searching for <strong>{displayedQuery}</strong> to refine these results.</p>}
        <MediaGrid items={catalog.results} priorityCount={6} />
        <Pagination page={catalog.page} totalPages={catalog.totalPages} pathname="/search" query={{ q: query }} />
      </>
    ) : (
      <section class="search-empty">
        <Search size={42} stroke-width={1.5} />
        <h2>{query ? "No matching titles" : "Start with a title"}</h2>
        <p>{query ? `No titles in the FMOVIES catalogue match “${query}”. Check the spelling or try a shorter title.` : "Enter a movie or TV-series title in the search box above."}</p>
      </section>
    )}
  </div>
</BaseLayout>

<style>
  .search-heading {
    background: linear-gradient(135deg, var(--color-footer), #20262a);
  }

  .search-heading .container {
    max-width: 900px;
  }

  .search-heading p {
    max-width: 650px;
  }

  .search-form {
    display: flex;
    width: min(100%, 720px);
    gap: 10px;
    margin-top: 26px;
  }

  .search-form input {
    min-width: 0;
    min-height: 52px;
    flex: 1;
    height: 52px;
    padding: 0 18px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    outline: 0;
    background: var(--color-surface);
    color: #fff;
  }

  .search-form input:focus {
    border-color: var(--color-accent);
  }

  .search-form .button {
    min-height: 52px;
  }

  .search-note {
    margin: 0 0 28px;
    color: var(--color-muted);
  }

  .search-note strong {
    color: var(--color-accent);
  }

  .search-empty {
    display: flex;
    min-height: 330px;
    align-items: center;
    flex-direction: column;
    justify-content: center;
    text-align: center;
  }

  .search-empty > svg {
    color: var(--color-accent);
  }

  .search-empty h2 {
    margin: 18px 0 6px;
    font-size: 28px;
  }

  .search-empty p {
    max-width: 560px;
    margin: 0;
    color: var(--color-muted);
  }

  @media (max-width: 620px) {
    .search-form {
      flex-direction: column;
    }

    .search-form .button {
      width: 100%;
    }

    .search-form input {
      flex: 0 0 52px;
      width: 100%;
    }
  }
</style>
