---
import { CalendarDays, Clock3, Play, Star, X } from "@lucide/astro";
import { countryName } from "../lib/country";
import { getImageUrl } from "../lib/images";
import { mediaPath } from "../lib/media-url";
import { genrePath } from "../lib/genre-url";
import type { MediaDetails } from "../types/media";
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "./Breadcrumbs.astro";
import MediaSection from "./MediaSection.astro";

interface Props {
  details: MediaDetails;
}

const { details } = Astro.props;
const year = details.releaseDate.slice(0, 4) || "TBA";
const duration = details.mediaType === "movie"
  ? details.runtime ? `${Math.floor(details.runtime / 60)}h ${details.runtime % 60}m` : "Runtime TBA"
  : details.seasons ? `${details.seasons} season${details.seasons === 1 ? "" : "s"}` : "Seasons TBA";
const description = details.overview || `Explore ${details.title}, its cast and related titles.`;
const shareImage = details.backdropPath ? getImageUrl(details.backdropPath, "w1280") : undefined;
const canonicalPath = mediaPath(details.mediaType, details.id, details.title);
const pageDescription = description.length > 160 ? `${description.slice(0, 157).trimEnd()}...` : description;
const mediaLabel = details.mediaType === "movie" ? "Movie" : "TV Series";
const trailerEmbedUrl = details.trailerKey
  ? `https://www.youtube-nocookie.com/embed/${details.trailerKey}?autoplay=1&rel=0&modestbranding=1`
  : null;
const parentPath = details.mediaType === "movie" ? "/movies" : "/tv-series";
const parentLabel = details.mediaType === "movie" ? "Movies" : "TV Series";
const directorNames = details.directors.map((director) => director.name);
const countryNames = details.countries.map(countryName);
const breadcrumbs = [
  { href: "/home", label: "Home" },
  { href: parentPath, label: parentLabel },
  { label: details.title },
];
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": details.mediaType === "movie" ? "Movie" : "TVSeries",
      name: details.title,
      description: pageDescription,
      url: new URL(canonicalPath, Astro.site).href,
      ...(shareImage ? { image: shareImage } : {}),
      ...(details.releaseDate ? { datePublished: details.releaseDate } : {}),
      ...(details.genres.length ? { genre: details.genres.map((genre) => genre.name) } : {}),
      ...(directorNames.length ? { director: directorNames.map((name) => ({ "@type": "Person", name })) } : {}),
      ...(countryNames.length ? { countryOfOrigin: countryNames.map((name) => ({ "@type": "Country", name })) } : {}),
      ...(details.cast.length ? { actor: details.cast.map((person) => ({ "@type": "Person", name: person.name })) } : {}),
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: new URL("/home", Astro.site).href },
        { "@type": "ListItem", position: 2, name: parentLabel, item: new URL(parentPath, Astro.site).href },
        { "@type": "ListItem", position: 3, name: details.title, item: new URL(canonicalPath, Astro.site).href },
      ],
    },
  ],
};
---

<BaseLayout
  title={`${details.title} (${year}) - ${mediaLabel} Details | FMOVIES`}
  description={pageDescription}
  image={shareImage}
  imageWidth={1280}
  imageHeight={720}
  openGraphType={details.mediaType === "movie" ? "video.movie" : "video.tv_show"}
  structuredData={structuredData}
>
  <article class="details">
    <Breadcrumbs items={breadcrumbs} />
    <section class="details-hero">
      <img class="details-backdrop" src={getImageUrl(details.backdropPath, "w1280")} alt="" width="1280" height="720" />
      <div class="details-overlay" aria-hidden="true"></div>
      <div class="details-content container">
        <img class="details-poster" src={getImageUrl(details.posterPath, "w500")} alt={`${details.title} poster`} width="500" height="750" />
        <div class="details-copy">
          <span class="details-kicker">{details.mediaType === "movie" ? "Movie" : "TV Series"}</span>
          <h1>{details.title}</h1>
          {details.tagline && <p class="tagline">{details.tagline}</p>}
          <div class="details-meta">
            <strong>HD</strong>
            <span class="score"><Star size={15} fill="currentColor" /> {details.voteAverage.toFixed(1)}</span>
            <span><CalendarDays size={15} /> {year}</span>
            <span><Clock3 size={15} /> {duration}</span>
          </div>
          <p class="overview">{description}</p>
          <div class="genres">
            {details.genres.map((genre) => <a href={genrePath(genre)}>{genre.name}</a>)}
          </div>
          <div class="details-actions">
            {trailerEmbedUrl ? (
              <button class="button button-primary" type="button" data-open-trailer><Play size={18} fill="currentColor" /> Watch now</button>
            ) : (
              <span class="trailer-unavailable">Trailer unavailable</span>
            )}
            {details.status && <span>Status: {details.status}</span>}
          </div>
          {(directorNames.length > 0 || countryNames.length > 0) && (
            <dl class="title-facts" aria-label={`${details.title} production details`}>
              {directorNames.length > 0 && (
                <div>
                  <dt>Director{directorNames.length === 1 ? "" : "s"}</dt>
                  <dd>{directorNames.join(", ")}</dd>
                </div>
              )}
              {countryNames.length > 0 && (
                <div>
                  <dt>{countryNames.length === 1 ? "Country" : "Countries"}</dt>
                  <dd>{countryNames.join(", ")}</dd>
                </div>
              )}
            </dl>
          )}
        </div>
      </div>
    </section>

    {details.cast.length > 0 && (
      <section class="cast-section container">
        <div class="section-title">
          <span class="section-kicker">People</span>
          <h2>Top cast</h2>
        </div>
        <div class="cast-list">
          {details.cast.map((person) => (
            <article class="cast-person">
              <img src={getImageUrl(person.profilePath, "w185")} alt={person.name} width="185" height="278" loading="lazy" />
              <h3>{person.name}</h3>
              <p>{person.character || "Cast"}</p>
            </article>
          ))}
        </div>
      </section>
    )}

    {details.similar.length > 0 && (
      <div class="similar-wrap container">
        <MediaSection title="You may also like" eyebrow="More to explore" items={details.similar} />
      </div>
    )}
  </article>

  {trailerEmbedUrl && (
    <dialog class="trailer-dialog" data-trailer-dialog>
      <button class="dialog-close" type="button" aria-label="Close trailer" data-close-trailer><X size={20} /></button>
      <div class="trailer-frame">
        <iframe
          title={`${details.title} trailer`}
          data-trailer-src={trailerEmbedUrl}
          allow="autoplay; encrypted-media; picture-in-picture"
          allowfullscreen
          referrerpolicy="strict-origin-when-cross-origin"
        ></iframe>
      </div>
      <p>Trailer provided by YouTube.</p>
    </dialog>
  )}

  <script>
    const dialog = document.querySelector("[data-trailer-dialog]");
    const openButton = document.querySelector("[data-open-trailer]");
    const closeButtons = document.querySelectorAll("[data-close-trailer]");
    openButton?.addEventListener("click", () => {
      if (!(dialog instanceof HTMLDialogElement)) return;
      const frame = dialog.querySelector("iframe[data-trailer-src]");
      if (frame instanceof HTMLIFrameElement && !frame.getAttribute("src")) frame.src = frame.dataset.trailerSrc ?? "";
      dialog.showModal();
    });
    closeButtons.forEach((button) => button.addEventListener("click", () => {
      if (dialog instanceof HTMLDialogElement) dialog.close();
    }));
    dialog?.addEventListener("click", (event) => {
      if (event.target === dialog && dialog instanceof HTMLDialogElement) dialog.close();
    });
    dialog?.addEventListener("close", () => {
      const frame = dialog.querySelector("iframe");
      if (frame instanceof HTMLIFrameElement) frame.src = "";
    });
  </script>
</BaseLayout>

<style>
  .details-hero {
    position: relative;
    min-height: 660px;
    overflow: hidden;
    background: var(--color-footer);
  }

  .details-backdrop {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 25%;
    opacity: 0.66;
  }

  .details-overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(19, 21, 26, 0.98) 0%, rgba(19, 21, 26, 0.72) 54%, rgba(19, 21, 26, 0.34)),
      linear-gradient(0deg, var(--color-bg) 0%, rgba(30, 33, 41, 0) 42%);
  }

  .details-content {
    position: relative;
    z-index: 2;
    display: grid;
    min-height: 660px;
    grid-template-columns: 280px minmax(0, 700px);
    align-items: center;
    gap: 48px;
    padding-top: 52px;
    padding-bottom: 52px;
  }

  .details-poster {
    width: 280px;
    aspect-ratio: 2 / 3;
    border-radius: var(--radius);
    object-fit: cover;
    box-shadow: 0 22px 50px rgba(0, 0, 0, 0.42);
  }

  .details-kicker {
    color: var(--color-accent);
    font-size: 12px;
    font-weight: 850;
    text-transform: uppercase;
  }

  .details-copy h1 {
    margin: 7px 0 0;
    font-size: clamp(42px, 5vw, 58px);
    line-height: 1.04;
  }

  .tagline {
    margin: 10px 0 0;
    color: #d9dde4;
    font-size: 17px;
    font-style: italic;
  }

  .details-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 18px;
    margin-top: 22px;
    color: #d8dce2;
    font-size: 13px;
    font-weight: 700;
  }

  .details-meta span {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .details-meta strong {
    padding: 4px 7px;
    border-radius: var(--radius-sm);
    background: var(--color-accent);
    color: #14170d;
    font-size: 11px;
  }

  .details-meta .score {
    color: var(--color-rating);
  }

  .overview {
    max-width: 690px;
    margin: 22px 0 0;
    color: #d1d5dc;
    font-size: 16px;
    line-height: 1.72;
  }

  .genres {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin-top: 20px;
  }

  .genres a {
    padding: 6px 10px;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: var(--radius-sm);
    background: rgba(19, 21, 26, 0.45);
    color: #d8dce2;
    font-size: 12px;
    font-weight: 650;
  }

  .genres a:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .details-actions {
    display: flex;
    align-items: center;
    gap: 18px;
    margin-top: 27px;
  }

  .details-actions > span {
    color: var(--color-muted);
    font-size: 12px;
  }

  .title-facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    max-width: 690px;
    margin: 27px 0 0;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: var(--radius);
    background: rgba(11, 13, 17, 0.52);
  }

  .title-facts div {
    min-width: 0;
    padding: 14px 17px;
    background: rgba(27, 30, 38, 0.72);
  }

  .title-facts dt {
    color: var(--color-accent);
    font-size: 10px;
    font-weight: 850;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .title-facts dd {
    margin: 5px 0 0;
    overflow: hidden;
    color: #f2f4f7;
    font-size: 14px;
    font-weight: 700;
    line-height: 1.4;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .cast-section {
    padding-top: 50px;
  }

  .section-title h2 {
    margin: 3px 0 20px;
    font-size: 25px;
  }

  .cast-list {
    display: grid;
    grid-template-columns: repeat(10, minmax(0, 1fr));
    gap: 14px;
  }

  .cast-person {
    min-width: 0;
  }

  .cast-person img {
    width: 100%;
    aspect-ratio: 2 / 3;
    border-radius: var(--radius);
    object-fit: cover;
    object-position: center top;
    background: var(--color-surface);
  }

  .cast-person h3 {
    margin: 9px 0 0;
    overflow: hidden;
    font-size: 12px;
    line-height: 1.3;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .cast-person p {
    margin: 3px 0 0;
    overflow: hidden;
    color: var(--color-subtle);
    font-size: 11px;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .similar-wrap {
    padding-bottom: 70px;
  }

  .trailer-unavailable {
    color: var(--color-muted);
    font-size: 13px;
    font-weight: 700;
  }

  .trailer-dialog {
    width: min(960px, calc(100% - 32px));
    padding: 14px 14px 18px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    color: var(--color-text);
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.5);
  }

  .trailer-dialog::backdrop {
    background: rgba(8, 9, 11, 0.78);
    backdrop-filter: blur(5px);
  }

  .dialog-close {
    position: absolute;
    top: 10px;
    right: 10px;
    display: grid;
    width: 38px;
    height: 38px;
    place-items: center;
    border: 0;
    background: transparent;
    color: var(--color-muted);
    cursor: pointer;
  }

  .trailer-frame {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: var(--radius);
    background: #090a0d;
  }

  .trailer-frame iframe {
    width: 100%;
    height: 100%;
    border: 0;
  }

  .trailer-dialog p {
    margin: 13px 34px 0 2px;
    color: var(--color-muted);
    font-size: 14px;
  }

  @media (max-width: 900px) {
    .cast-list {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }

  @media (max-width: 767px) {
    .details-hero,
    .details-content {
      min-height: 650px;
    }

    .details-backdrop {
      opacity: 0.52;
    }

    .details-overlay {
      background: linear-gradient(0deg, var(--color-bg) 0%, rgba(20, 22, 27, 0.4) 68%, rgba(20, 22, 27, 0.62));
    }

    .details-content {
      display: flex;
      align-items: flex-start;
      flex-direction: column;
      justify-content: flex-end;
      gap: 0;
      padding-bottom: 58px;
    }

    .details-poster {
      display: none;
    }

    .details-copy h1 {
      font-size: clamp(36px, 10vw, 46px);
    }

    .overview {
      display: -webkit-box;
      overflow: hidden;
      font-size: 14px;
      line-height: 1.62;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 4;
    }

    .title-facts {
      margin-top: 22px;
    }

    .cast-list {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 16px 10px;
    }

    .cast-person:nth-child(n + 9) {
      display: none;
    }
  }

  @media (max-width: 440px) {
    .title-facts {
      grid-template-columns: 1fr;
    }

    .cast-list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .cast-person:nth-child(n + 7) {
      display: none;
    }

    .trailer-dialog {
      padding: 32px 22px 26px;
    }
  }
</style>
