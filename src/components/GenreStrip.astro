---
import { ArrowRight } from "@lucide/astro";
import type { Genre } from "../types/media";

interface Props {
  genres: Genre[];
}

const { genres } = Astro.props;
---

<section class="genre-section">
  <div class="container">
    <div class="genre-heading">
      <div>
        <span class="section-kicker">Browse by mood</span>
        <h2>Explore genres</h2>
      </div>
      <a href="/movies">All movies <ArrowRight size={16} /></a>
    </div>
    <div class="genre-list">
      {genres.slice(0, 12).map((genre) => <a href={`/genre/${genre.id}`}>{genre.name}</a>)}
    </div>
  </div>
</section>

<style>
  .genre-section {
    margin-top: 54px;
    padding: 48px 0 56px;
    border-top: 1px solid var(--color-border);
    background: var(--color-surface);
  }

  .genre-heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 24px;
  }

  h2 {
    margin: 4px 0 0;
    font-size: 26px;
  }

  .genre-heading > a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--color-muted);
    font-size: 13px;
    font-weight: 700;
  }

  .genre-heading > a:hover {
    color: var(--color-accent);
  }

  .genre-list {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 9px;
  }

  .genre-list a {
    display: flex;
    min-height: 46px;
    align-items: center;
    padding: 0 14px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-bg);
    color: var(--color-muted);
    font-size: 13px;
    font-weight: 700;
    transition: color var(--transition-fast), border-color var(--transition-fast), background var(--transition-fast);
  }

  .genre-list a:hover {
    border-color: rgba(183, 227, 43, 0.45);
    background: var(--color-footer);
    color: var(--color-accent);
  }

  @media (max-width: 900px) {
    .genre-list {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .genre-section {
      margin-top: 42px;
      padding: 38px 0 44px;
    }

    .genre-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
