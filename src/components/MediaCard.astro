---
import { CirclePlay, Star } from "@lucide/astro";
import { getImageUrl } from "../lib/images";
import { mediaUrl } from "../lib/media-url";
import type { MediaItem } from "../types/media";

interface Props {
  item: MediaItem;
  priority?: boolean;
}

const { item, priority = false } = Astro.props;
const href = mediaUrl(item);
const year = item.releaseDate ? item.releaseDate.slice(0, 4) : "TBA";
---

<article class="media-card">
  <a href={href} aria-label={`View ${item.title}`}>
    <div class="poster-wrap">
      <img
        src={getImageUrl(item.posterPath, "w342")}
        alt={`${item.title} poster`}
        width="342"
        height="513"
        loading={priority ? "eager" : "lazy"}
        fetchpriority={priority ? "high" : "auto"}
      />
      <span class="quality">HD</span>
      <span class="rating"><Star size={12} fill="currentColor" /> {item.voteAverage.toFixed(1)}</span>
      <span class="card-action" aria-hidden="true"><CirclePlay size={42} stroke-width={1.5} /></span>
      <span class="poster-shade" aria-hidden="true"></span>
    </div>
    <h3>{item.title}</h3>
    <div class="card-meta">
      <span>{year}</span>
      <span>{item.mediaType === "movie" ? "Movie" : "TV Series"}</span>
    </div>
  </a>
</article>

<style>
  .media-card {
    min-width: 0;
  }

  .media-card a {
    display: block;
  }

  .poster-wrap {
    position: relative;
    aspect-ratio: 2 / 3;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--color-surface);
    box-shadow: 0 7px 18px rgba(0, 0, 0, 0.18);
  }

  .poster-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 300ms ease, filter 300ms ease;
  }

  .quality,
  .rating {
    position: absolute;
    z-index: 3;
    top: 9px;
    display: inline-flex;
    height: 23px;
    align-items: center;
    border-radius: var(--radius-sm);
    font-size: 11px;
    font-weight: 850;
    line-height: 1;
  }

  .quality {
    left: 9px;
    padding: 0 7px;
    background: var(--color-accent);
    color: #14170d;
  }

  .rating {
    right: 9px;
    gap: 4px;
    padding: 0 7px;
    background: rgba(19, 21, 26, 0.82);
    color: var(--color-rating);
    backdrop-filter: blur(4px);
  }

  .poster-shade {
    position: absolute;
    z-index: 1;
    inset: 0;
    background: linear-gradient(to top, rgba(10, 11, 14, 0.55), transparent 45%);
    opacity: 0.45;
    transition: opacity var(--transition-fast);
  }

  .card-action {
    position: absolute;
    z-index: 4;
    top: 50%;
    left: 50%;
    display: grid;
    width: 54px;
    height: 54px;
    place-items: center;
    color: #fff;
    opacity: 0;
    transform: translate(-50%, -42%) scale(0.88);
    transition: opacity var(--transition-fast), transform var(--transition-fast);
  }

  h3 {
    min-height: 44px;
    margin: 12px 0 3px;
    overflow: hidden;
    color: var(--color-text);
    display: -webkit-box;
    font-size: 15px;
    font-weight: 680;
    line-height: 1.45;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    transition: color var(--transition-fast);
  }

  .card-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    color: var(--color-subtle);
    font-size: 12px;
  }

  .media-card a:hover .poster-wrap img,
  .media-card a:focus-visible .poster-wrap img {
    filter: brightness(0.72);
    transform: scale(1.045);
  }

  .media-card a:hover .card-action,
  .media-card a:focus-visible .card-action {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
  }

  .media-card a:hover h3 {
    color: var(--color-accent);
  }

  @media (max-width: 560px) {
    h3 {
      min-height: 41px;
      margin-top: 9px;
      font-size: 14px;
    }
  }
</style>
