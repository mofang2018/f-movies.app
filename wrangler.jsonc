{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "f-movies-app",
  "workers_dev": false,
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-07-22",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    { "pattern": "watchfmovies.org/*", "zone_name": "watchfmovies.org" },
    { "pattern": "www.watchfmovies.org/*", "zone_name": "watchfmovies.org" }
  ],
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "CATALOG_DB",
      "database_name": "f-movies-catalog",
      "database_id": "0f662055-f012-4f1c-9570-c0760488f5ca"
    }
  ],
  "vars": {
    "PUBLIC_IMAGE_CDN_URL": "https://images.watchfmovies.org"
  }
}
