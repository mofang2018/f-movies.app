{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "f-movies-app",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-07-22",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "vars": {
    "PUBLIC_IMAGE_CDN_URL": "https://images.f-movies.app"
  }
}
